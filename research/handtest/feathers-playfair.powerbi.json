{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "Feathers handtest - Playfair",
  "dataColors": ["#0A3746", "#F99A2B", "#0F542C", "#8A1E00", "#B2AF73", "#B36000", "#03222C", "#9C8F82"],
  "good": "#0F542C",
  "neutral": "#B2AF73",
  "bad": "#8A1E00",
  "maximum": "#0A3746",
  "center": "#F3F4EF",
  "minimum": "#F99A2B",
  "foreground": "#201914",
  "firstLevelElements": "#201914",
  "secondLevelElements": "#4A403A",
  "thirdLevelElements": "#DDDAD3",
  "fourthLevelElements": "#9C8F82",
  "background": "#FFFFFF",
  "secondaryBackground": "#DDDAD3",
  "tableAccent": "#0A3746",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#201914" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A403A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 40, "color": "#0A3746" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#201914" }
  },
  "visualStyles": {
    "page": { "*": {
      "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
      "outspace":   [{ "color": { "solid": { "color": "#F3F4EF" } }, "transparency": 0 }]
    } },
    "*": { "*": {
      "background":   [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
      "categoryAxis": [{ "gridlineShow": true, "gridlineStyle": "dotted", "gridlineColor": { "solid": { "color": "#DDDAD3" } } }],
      "valueAxis":    [{ "gridlineShow": true, "gridlineStyle": "dotted", "gridlineColor": { "solid": { "color": "#DDDAD3" } } }]
    } }
  }
}
